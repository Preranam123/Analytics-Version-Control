	partition DimDate = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (
				        DATE(2026,1,1),
				        DATE(2026,12,31)
				    ),
				    "Year", YEAR([Date]),
				    "Month No", MONTH([Date]),
				    "Month", FORMAT([Date],"MMM"),
				    "Month Year", FORMAT([Date],"MMM yyyy"),
				    "Quarter", "Q" & FORMAT([Date],"Q"),
				    "Year Month Sort", YEAR([Date])*100 + MONTH([Date])
				)

	annotation PBI_Id = a79514ccf9a946c5ba97624a89ed6264

