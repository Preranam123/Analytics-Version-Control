			    KPI_Monthly[KPI] = "Total Clients"
			)
		formatString: 0
		lineageTag: da0fe2e0-b7ff-49ec-89ca-e924e595e8f7

	measure 'Total Leads' =
			
			CALCULATE(
			    MAX(KPI_Monthly[Actual]),
			    KPI_Monthly[KPI] = "Leads"
			)
		formatString: 0
		lineageTag: 8165fe1c-fae3-41fb-a4e7-397b26b4a9c9

	measure Escalations =
			
			CALCULATE(
			    MAX(KPI_Monthly[Actual]),
			    KPI_Monthly[KPI] = "Escalations"
			)
		formatString: 0
		lineageTag: a8eb9323-9cc5-4ce0-80b0-64daa08b979a

	measure 'Total Projects' =
			
