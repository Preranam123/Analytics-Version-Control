			    KPI_Monthly[KPI] = "Total Projects"
			)
		formatString: 0
		lineageTag: 5e605ece-4b22-4a73-8750-30fa5e595deb

	measure 'Billable Projects' =
			
			CALCULATE(
			    MAX(KPI_Monthly[Actual]),
			    KPI_Monthly[KPI] = "Billable Projects"
			)
		formatString: 0
		lineageTag: 16e1d85d-dd60-4329-81e7-9835128f2bde

	measure 'Internal Projects' =
			
			CALCULATE(
			    MAX(KPI_Monthly[Actual]),
			    KPI_Monthly[KPI] = "Internal Projects"
			)
		formatString: 0
		lineageTag: 4d0f242e-4d63-475c-8c21-ea7d96512778

	measure 'Critical Risks' =
			
			CALCULATE(
			    MAX(KPI_Monthly[Actual]),
			    KPI_Monthly[KPI] = "Critical Risks"
			)
		formatString: 0
		lineageTag: 95ca7038-0f64-412e-b97f-4b83d612bfe4

	measure 'Resource Shortages' =
			
			CALCULATE(
			    MAX(KPI_Monthly[Actual]),
			    KPI_Monthly[KPI] = "Resource Shortages"
			)
		formatString: 0
		lineageTag: 113396f5-d696-4627-bc62-6613b8574693

	measure 'Total Revenue' =
			
			SUM(Revenue_vs_Cost[Revenue])
		formatString: 0
		lineageTag: 0dd994c5-3fae-4f36-a925-881f5a34778a

	measure 'Total Cost' =
			
			SUM(Revenue_vs_Cost[Cost])
		formatString: 0
		lineageTag: 12db85d3-6918-4638-bf9a-80a51af46544

	measure Profit =
			
			[Total Revenue] - [Total Cost]
		formatString: 0
		lineageTag: 0ef8eeb1-daa5-458c-bdc0-25415434c740

	measure 'Profit Margin %' =
			
			DIVIDE(
			    [Profit],
			    [Total Revenue]
			)
		formatString: 0%;-0%;0%
		lineageTag: 860c834a-a55b-498d-9961-7675a06092eb

	measure 'Total Workforce' =
			
			SUM(Workforce_Mix[Employees])
		formatString: 0
		lineageTag: 8a32dc3f-9947-40cf-acde-e48c38759c2b

	measure 'Workforce %' =
			
			DIVIDE(
			    SUM(Workforce_Mix[Employees]),
			    CALCULATE(
			        SUM(Workforce_Mix[Employees]),
			        ALL(Workforce_Mix)
			    )
			)
		lineageTag: 5be7b007-391d-4f0d-90c8-8d560d4ee658

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Headcount' =
			
			SUM(Capacity_Domain[Headcount])
		formatString: 0
		lineageTag: 5760d4a9-b822-42f6-983d-30ba3a42fb7f

	measure 'Domain Capacity %' =
			
			DIVIDE(
			    SUM(Capacity_Domain[Headcount]),
			    CALCULATE(
			        SUM(Capacity_Domain[Headcount]),
			        ALL(Capacity_Domain)
			    )
			)
		formatString: 0%;-0%;0%
		lineageTag: c0962c59-af7a-4668-a392-f315947bf80e

	measure 'PM Projects' =
			
			SUM(PM_Scorecard[Projects])
		formatString: 0
		lineageTag: d92e18e7-51d1-4eee-93de-5a5a16aa7592

	measure 'Avg Utilization' =
			
