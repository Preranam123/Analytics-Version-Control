table 'Measures (2)'
	lineageTag: db731891-d2f6-4e2a-ad02-d3f954ce88b8

	measure 'Current Value' =
			
			MAX(KPI_Monthly[Actual])
		formatString: 0
		lineageTag: 3bc9a6e5-c55d-441b-bbb3-de54b2413fd0

	measure 'Target Value' =
			
			MAX(KPI_Monthly[Target])
		formatString: 0
		lineageTag: ed87b489-0433-44c9-9073-74b1abbfb110

	measure 'Previous Month' =
			
			CALCULATE(
			    MAX(KPI_Monthly[Actual]),
			    PREVIOUSMONTH(KPI_Monthly[Date])
			)
		formatString: 0
		lineageTag: 131003ae-54ac-4c42-a318-966ea0e6788e

	measure 'MoM Growth %' =
			
			DIVIDE(
			    [Current Value] - [Previous Month],
			    [Previous Month]
			)
		formatString: 0%;-0%;0%
		lineageTag: 8eaa943d-9056-4722-b056-6263ccbd534a

	measure Variance =
			
			[Current Value] - [Target Value]
		formatString: 0
		lineageTag: 6b673fee-d243-4b74-b185-a34d473fa810

	measure 'Variance %' =
			
			DIVIDE(
			    [Variance],
			    [Target Value]
			)
		formatString: 0%;-0%;0%
		lineageTag: 429b6589-9a73-4320-a6c8-ee65a25bbe35

	measure 'KPI Status' =
			
			SWITCH(
			    TRUE(),
			    [Variance %] >= 0 , "Green",
			    [Variance %] >= -0.1 , "Amber",
			    "Red"
			)
		lineageTag: 23919c10-1fef-45bc-a6ff-2747817b42c5

	measure 'Total Employees' =
			
			CALCULATE(
			    MAX(KPI_Monthly[Actual]),
			    KPI_Monthly[KPI] = "Total Employees"
			)
		formatString: 0
		lineageTag: 08ea5693-68c7-4f59-be0e-904cc0cb91e8

	measure 'Bench %' =
			
			DIVIDE(
			    CALCULATE(
			        MAX(KPI_Monthly[Actual]),
			        KPI_Monthly[KPI] = "Bench %"
			    ),
			    100
			)
		formatString: 0%;-0%;0%
		lineageTag: 6b56b83f-6b46-464a-82c2-ffcfb60c470c

	measure 'Billability %' =
			
			DIVIDE(
			    CALCULATE(
			        MAX(KPI_Monthly[Actual]),
			        KPI_Monthly[KPI] = "Billability %"
			    ),
			    100
			)
		formatString: 0%;-0%;0%
		lineageTag: 844a9151-1e10-498f-a99e-5b9464053e44

	measure 'Utilization %' =
			
			DIVIDE(
			    CALCULATE(
			        MAX(KPI_Monthly[Actual]),
			        KPI_Monthly[KPI] = "Utilization %"
			    ),
			    100
			)
		formatString: 0%;-0%;0%
		lineageTag: d4080cb3-0c95-4dbf-bfb3-e376c750fe15

	measure 'Total Clients' =
			
			CALCULATE(
