	measure Measure
		lineageTag: 4f9631a9-1714-4b0a-ada7-db0effb556b4

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Previous Month Employees' =
			
			VAR CurrentDate =
			    CALCULATE(
			        MAX(KPI_Monthly[Date]),
			        KPI_Monthly[KPI] = "Total Employees"
			    )
			RETURN
			CALCULATE(
			    MAX(KPI_Monthly[Actual]),
			    FILTER(
			        ALL(KPI_Monthly),
			        KPI_Monthly[KPI] = "Total Employees"
			            && KPI_Monthly[Date] = EDATE(CurrentDate,-1)
			    )
			)
		formatString: 0
		lineageTag: e106fb4e-d68c-4498-aa54-1983051bfac3

	measure 'Employee MoM' =
			
			DIVIDE(
			    [Total Employees] - [Previous Month Employees],
			    [Previous Month Employees]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0d0ee827-6861-4b52-94d0-fa425b92a9e7

	measure 'Contracts Expiring' =
			
			4
		formatString: 0
		lineageTag: 46f2520f-238d-40d5-8ac4-c3b38c7d4a3d

	measure 'Invoices Overdue' =
			
			2
		formatString: 0
		lineageTag: 582feb69-ecb6-48dd-a0db-4cb66c241de4

