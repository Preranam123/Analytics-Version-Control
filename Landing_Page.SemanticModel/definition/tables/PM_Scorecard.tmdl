		annotation SummarizationSetBy = Automatic

	column Risks
		dataType: int64
		formatString: 0
		lineageTag: a9be0149-cd9a-4ef1-b5da-130e0a3c6ea4
		summarizeBy: sum
		sourceColumn: Risks

		annotation SummarizationSetBy = Automatic

	partition PM_Scorecard = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\Prerana\Downloads\Founder_Command_Center_Updated_Dataset.xlsx"), null, true),
				    PM_Scorecard_Sheet = Source{[Item="PM_Scorecard",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(PM_Scorecard_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"PMName", type text}, {"Department", type text}, {"Projects", Int64.Type}, {"UtilizationPct", Int64.Type}, {"BillabilityPct", Int64.Type}, {"Risks", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

