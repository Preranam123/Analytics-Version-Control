table PM_Scorecard
	lineageTag: 51c3f417-b8fa-4bfc-ab1d-6e5a38ea4ee6

	measure 'PM Utilization %' =
			
			DIVIDE(
			    SELECTEDVALUE(PM_Scorecard[UtilizationPct]),
			    100
			)
		formatString: 0%;-0%;0%
		lineageTag: 3448d535-e757-4254-8271-11fec4f592f7

	measure 'Bill %' =
			
			DIVIDE(
			    SELECTEDVALUE(PM_Scorecard[BillabilityPct]),
			    100
			)
		formatString: 0%;-0%;0%
		lineageTag: 9ea076b3-8e69-404b-88b2-7977da3e642b

	column PMName
		dataType: string
		lineageTag: 206e99cd-f68e-4559-8be5-55a07320ff0d
		summarizeBy: none
		sourceColumn: PMName

		annotation SummarizationSetBy = Automatic

	column Department
		dataType: string
		lineageTag: 0e7d5c16-34af-4fc1-8c36-06fe2f2daecf
		summarizeBy: none
