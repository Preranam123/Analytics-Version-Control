table Revenue_vs_Cost_New
	lineageTag: edf4bb36-97bb-4f88-bc35-0a821b1129be

	measure 'Total RevenueNew' =
			
			SUM(Revenue_vs_Cost_New[Revenue])
		formatString: 0
		lineageTag: 3b897a72-b705-462f-a68b-7a61f27def7e

	measure 'Total CostNew' =
			
			SUM(Revenue_vs_Cost_New[Cost])
		formatString: 0
		lineageTag: 679f159b-10e2-4eaf-a6f1-689dd619924c

	measure ProfitN =
			
			[Total Revenue] - [Total Cost]
		formatString: 0
		lineageTag: b401d3d4-3c63-4d29-9e52-e910d9aa1c06

	measure 'NProfit Margin %' =
			
			DIVIDE(
			    [Profit],
			    [Total Revenue]
			)
		lineageTag: e5735da8-d957-4303-a4fb-2340b56089e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

